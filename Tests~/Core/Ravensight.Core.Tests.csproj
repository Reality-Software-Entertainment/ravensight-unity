<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine free tests for Runtime/Core, run on .NET with xUnit. The sources
    live in Tests/Editor/Core so the Unity Editor runs the same files through
    its own test runner (Tests/Editor/XunitShim.cs maps the xUnit calls onto
    NUnit there). This folder name ends in "~", so Unity ignores the project
    file itself. Run with Tools/test.sh or dotnet test "Tests~/Core".
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealitySE.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../Tests/Editor/Core/*.cs" Link="Tests/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
